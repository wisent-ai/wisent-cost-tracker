{
  "name": "@wisent/cost-tracker",
  "version": "0.1.1",
  "description": "Per-agent cost tracking and budget enforcement (TS client).",
  "engines": { "node": ">=22" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./pricing.json": "./dist/pricing/costs.json"
  },
  "files": ["dist", "pricing", "README.md"],
  "scripts": {
    "build": "tsc && mkdir -p dist/pricing && cp pricing/costs.json dist/pricing/costs.json",
    "prepare": "npm run build",
    "sync-pricing": "cp pricing/costs.json py/src/wisent_cost_tracker/pricing/costs.json && echo synced"
  },
  "keywords": ["cost", "budget", "tracking", "wisent"],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisent-ai/wisent-cost-tracker.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
